# Generated by Cargo
# will have compiled files and executables
debug/
target/

# The agent is an executable, so its root-workspace Cargo.lock is tracked for a
# reproducible dependency graph. We only ignore the separate tools/lint dev-tool
# workspace lock; the anchored path keeps the ignore scoped to that nested lock
# so the root Cargo.lock stays tracked.
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
/tools/lint/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# docker tarballs used for testing
*.gz

# zip file
*.zip
*.deb

prod/
local/
dev/
deleteme_dir/

# distribution files
dist/
zig*/

.vscode/
.venv/
venv/
.env/

# python
.mypy_cache/

# api
**/codegen/

# coverage reports
target/coverage/