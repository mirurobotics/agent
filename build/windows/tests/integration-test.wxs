<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="MIRUDATA">
      <Component Id="RollbackFixturePayload" Guid="52FC030C-C305-4935-B6A9-A88B193EF4F4" Bitness="always64">
        <File Id="RollbackFixtureFile"
              Name="rollback-payload.txt"
              Source="$(FixturePayloadPath)"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="IntegrationFixturePayload">
      <ComponentRef Id="RollbackFixturePayload" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <CustomAction Id="FailUpgradeForTest"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]cmd.exe /d /c exit /b 1"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <!-- Fail as late as possible: after the new product has replaced the
         executable, reconfigured and restarted the existing service, and
         RemoveExistingProducts has removed the old product, so rollback must
         undo all of it. -->
    <InstallExecuteSequence>
      <Custom Action="FailUpgradeForTest"
              After="RemoveExistingProducts"
              Condition="FAIL_UPGRADE_FOR_TEST=1" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
