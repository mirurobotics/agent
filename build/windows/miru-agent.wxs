<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?define ProductName = "Miru Agent" ?>
  <?define Manufacturer = "Miru" ?>
  <!-- `sc.exe showsid miru-agent`; hardcoded because CreateFolders runs before
       the service exists. Recompute if the service Name changes. -->
  <?define ServiceSid ="S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695" ?>
  <!-- ProgramData\Miru: the service can only read and traverse it. -->
  <?define RootSddl = "O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFX;;;$(ServiceSid))" ?>
  <!-- The service can use the folder but not delete or re-permission it, and
       has full control of its contents. -->
  <?define AgentPrivateSddl = "O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;$(ServiceSid))(A;OICIIO;FA;;;$(ServiceSid))" ?>
  <!-- SYSTEM and Administrators only. -->
  <?define SentinelSddl ="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" ?>
  <?ifndef ProductCode ?><?define ProductCode = "*" ?><?endif ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           ProductCode="$(ProductCode)"
           UpgradeCode="B5ED0336-5F14-4308-A667-3CE8CDEF7D48"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">
    <!-- Never change UpgradeCode after publication: it is the permanent identity
         that relates every Miru Agent major-upgrade package. -->
    <!-- Windows Installer ignores the fourth version field when comparing
         products, so a prerelease MSI (0.10.4.201 for v0.10.4-beta.1) has the
         same effective version as its stable release (0.10.4).
         AllowSameVersionUpgrades lets later betas and the stable release
         replace it in place; lower versions are still rejected as downgrades. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of $(ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Miru">
        <Directory Id="AGENTFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="MIRUDATA" Name="Miru">
        <Directory Id="MIRUAGENTDATA" Name="Agent">
          <Directory Id="MIRUAGENTLOGS" Name="logs">
            <Directory Id="MIRUAGENTLOGSSENTINEL" Name="installer-sentinel" />
          </Directory>
          <Directory Id="MIRUAGENTAUTH" Name="auth">
            <Directory Id="MIRUAGENTAUTHSENTINEL" Name="installer-sentinel" />
          </Directory>
          <Directory Id="MIRUAGENTTMP" Name="tmp">
            <Directory Id="MIRUAGENTTMPSENTINEL" Name="installer-sentinel" />
          </Directory>
        </Directory>
        <Directory Id="MIRUDEVICEAPI" Name="device-api">
          <Directory Id="MIRUDEVICEAPISENTINEL" Name="installer-sentinel" />
        </Directory>
        <Directory Id="MIRUCONFIGS" Name="configs">
          <Directory Id="MIRUCONFIGSSENTINEL" Name="installer-sentinel" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentBinary" Directory="AGENTFOLDER">
      <Component Id="MiruAgentExe" Guid="*" Bitness="always64">
        <File Id="miru_agent.exe"
              Name="miru-agent.exe"
              Source="$(BinDir)\miru-agent.exe"
              KeyPath="yes" />
        <!-- The SCM launches the bare exe (no subcommand, no console flag) as
             the service; Name must equal SERVICE_NAME in
             agent/src/windows/scm.rs. -->
        <ServiceInstall Id="MiruAgentService"
                        Name="miru-agent"
                        DisplayName="Miru Agent"
                        Description="Miru Config Agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\miru-agent"
                        Vital="yes"
                        Interactive="no">
          <!-- SCM restarts the service on failure; the Util extension is the
               reliable path to failure actions. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
          <!-- Service SID in the token; no privileges but SeChangeNotify (so no
               impersonation). util:ServiceConfig can't set these (WIX1149). -->
          <ServiceConfig ServiceSid="unrestricted" OnInstall="yes" OnReinstall="yes">
            <RequiredPrivilege Name="SeChangeNotifyPrivilege" />
          </ServiceConfig>
        </ServiceInstall>
        <ServiceControl Id="MiruAgentServiceControl"
                        Name="miru-agent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Each folder applies its own protected descriptor instead of inheriting
         one, which would let the service delete it. Undeletable sentinel
         folders keep each leaf folder non-empty, so none can become a mount
         point that a repair or upgrade follows. Nothing here has RemoveFolder:
         state survives uninstall, and repair and upgrade reapply the ACLs. -->
    <!-- Miru Agent Users (apps that use the agent) can read device-api (port
         and bearer token) and configs, and nothing else. Its SID differs per
         machine, so util:PermissionEx adds it by name. Never grant Users or
         Authenticated Users: the discovery file unlocks every device API
         route, and configs may hold secrets. -->
    <ComponentGroup Id="DataDirs">
      <Component Id="MiruDataDir" Directory="MIRUDATA" Guid="D0542DF7-5B61-4F09-938B-57F05C1B5458" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(RootSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentDataDir" Directory="MIRUAGENTDATA" Guid="CAAEBE5E-2175-4DFC-A6DE-62973DF3A85D" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentLogsDir" Directory="MIRUAGENTLOGS" Guid="8E86BA6A-C047-47C5-B274-515DBEE58C69" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentAuthDir" Directory="MIRUAGENTAUTH" Guid="B26BE954-6594-4944-AFCC-24A427B7A45A" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentTmpDir" Directory="MIRUAGENTTMP" Guid="D299C395-E3BF-4594-BAAC-36F4E4D18BA3" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruDeviceApiDir" Directory="MIRUDEVICEAPI" Guid="3CA14BB2-FB56-4907-93EF-45ED80886D9E" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
          <util:PermissionEx User="Miru Agent Users"
                             Read="yes" ReadAttributes="yes" ReadExtendedAttributes="yes"
                             ReadPermission="yes" Synchronize="yes" />
        </CreateFolder>
        <!-- UpdateIfExists: without it, WiX 7's CreateGroup fails (1603) when
             the group already exists, as on every major upgrade. -->
        <util:Group Id="MiruAgentUsersGroup"
                    Name="Miru Agent Users"
                    Comment="Local accounts whose applications use the Miru Agent"
                    UpdateIfExists="yes"
                    RemoveOnUninstall="no" />
      </Component>
      <Component Id="MiruConfigsDir" Directory="MIRUCONFIGS" Guid="8491B347-8F1B-45B1-9F15-B3EE02A99885" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(AgentPrivateSddl)" />
          <util:PermissionEx User="Miru Agent Users"
                             Read="yes" ReadAttributes="yes" ReadExtendedAttributes="yes"
                             ReadPermission="yes" Synchronize="yes" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentLogsSentinel" Directory="MIRUAGENTLOGSSENTINEL" Guid="3EB2C08A-9538-4383-ACF8-858CF225D209" Bitness="always64" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(SentinelSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentAuthSentinel" Directory="MIRUAGENTAUTHSENTINEL" Guid="EFC1A2C4-60B1-4915-A019-337A528CD424" Bitness="always64" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(SentinelSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAgentTmpSentinel" Directory="MIRUAGENTTMPSENTINEL" Guid="2B08A0FF-FE64-4103-B456-0FC8911C8C94" Bitness="always64" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(SentinelSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruDeviceApiSentinel" Directory="MIRUDEVICEAPISENTINEL" Guid="3E26D821-026B-49A2-964F-FEC9D3CFB2F6" Bitness="always64" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(SentinelSddl)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruConfigsSentinel" Directory="MIRUCONFIGSSENTINEL" Guid="91A81046-9E39-4AD5-836B-8F4884770163" Bitness="always64" KeyPath="yes" Permanent="yes">
        <CreateFolder>
          <PermissionEx Sddl="$(SentinelSddl)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- If removing this version fails (uninstall or upgrade), rollback recreates
         the service without the settings above. This rollback-only action, between
         StopServices and DeleteServices, reapplies them before it restarts. -->
    <CustomAction Id="MiruRollbackServiceConfig" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <SetProperty Id="MiruRollbackServiceConfig" Before="MiruRollbackServiceConfig" Sequence="execute"
                 Condition='REMOVE~="ALL"'
                 Value='"[System64Folder]cmd.exe" /d /s /c "cd /d "[System64Folder]" &amp; sc.exe failure miru-agent reset= 86400 actions= restart/10000/restart/10000/restart/10000 &amp; sc.exe sidtype miru-agent unrestricted &amp; sc.exe privs miru-agent SeChangeNotifyPrivilege"' />
    <InstallExecuteSequence>
      <Custom Action="MiruRollbackServiceConfig" Before="DeleteServices"
              Condition='REMOVE~="ALL"' />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="AgentBinary" />
      <ComponentGroupRef Id="DataDirs" />
      <?ifdef IntegrationFixture ?>
      <ComponentGroupRef Id="IntegrationFixturePayload" />
      <?endif ?>
    </Feature>

    <?ifdef IntegrationFixture ?>
    <CustomActionRef Id="FailUpgradeForTest" />
    <?endif ?>
  </Package>
</Wix>
