<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?define ProductName = "Miru Agent" ?>
  <?define Manufacturer = "Miru" ?>
  <?ifndef ProductCode ?><?define ProductCode = "*" ?><?endif ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           ProductCode="$(ProductCode)"
           UpgradeCode="B5ED0336-5F14-4308-A667-3CE8CDEF7D48"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">
    <!-- Never change UpgradeCode after publication: it is the permanent identity
         that relates every Miru Agent major-upgrade package. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Miru">
        <Directory Id="AGENTFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="MIRUDATA" Name="Miru">
        <Directory Id="MIRULOGS" Name="logs" />
        <Directory Id="MIRUAUTH" Name="auth" />
        <Directory Id="MIRUTMP" Name="tmp" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentBinary" Directory="AGENTFOLDER">
      <Component Id="MiruAgentExe" Guid="*" Bitness="always64">
        <File Id="miru_agent.exe"
              Name="miru-agent.exe"
              Source="$(BinDir)\miru-agent.exe"
              KeyPath="yes" />
        <!-- The SCM launches the bare exe (no subcommand, no console flag) as
             the service; Name must equal SERVICE_NAME in
             agent/src/windows/scm.rs. -->
        <ServiceInstall Id="MiruAgentService"
                        Name="miru-agent"
                        DisplayName="Miru Agent"
                        Description="Miru Config Agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\miru-agent"
                        Vital="yes"
                        Interactive="no">
          <!-- SCM restarts the service on failure; the Util extension is the
               reliable path to failure actions. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
          <!-- Core ServiceConfig (MsiServiceConfig), applied on install and
               repair: add the service SID to the process token and remove every
               privilege except SeChangeNotifyPrivilege, so the service cannot
               impersonate. util:ServiceConfig supports neither setting; WIX1149
               is suppressed in miru-agent.wixproj for this element. -->
          <ServiceConfig ServiceSid="unrestricted" OnInstall="yes" OnReinstall="yes">
            <RequiredPrivilege Name="changeNotify" />
          </ServiceConfig>
        </ServiceInstall>
        <ServiceControl Id="MiruAgentServiceControl"
                        Name="miru-agent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- These directory-keyed components deliberately contain no RemoveFolder or
         registry resource. Windows Installer reapplies the protected descriptor
         during repair and upgrade, while populated customer state survives an
         ordinary uninstall.
         The last two ACEs are for the miru-agent service SID (NT SERVICE\miru-agent;
         equals `sc.exe showsid miru-agent`). On each directory it may list,
         traverse, and add children but not delete, re-permission, or take
         ownership of the directory itself; it gets full control of everything
         created inside. The SID is hardcoded because CreateFolders applies these
         descriptors before InstallServices creates the service. All four
         directories carry the ACEs because their DACLs are protected and
         provisioning renames keys from tmp to auth. Recompute the SID in every
         Sddl if the ServiceInstall Name changes. -->
    <ComponentGroup Id="DataDirs">
      <Component Id="MiruDataDir" Directory="MIRUDATA" Guid="D0542DF7-5B61-4F09-938B-57F05C1B5458" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruLogsDir" Directory="MIRULOGS" Guid="C3AF8332-28E8-4707-8430-780C553D86EC" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAuthDir" Directory="MIRUAUTH" Guid="A2AE361A-41E6-427A-AF4C-ACCEE7F451F9" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruTmpDir" Directory="MIRUTMP" Guid="D654A9BF-2860-44FA-8FFB-A8E36986197B" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="AgentBinary" />
      <ComponentGroupRef Id="DataDirs" />
      <?ifdef IntegrationFixture ?>
      <ComponentGroupRef Id="IntegrationFixturePayload" />
      <?endif ?>
    </Feature>

    <?ifdef IntegrationFixture ?>
    <CustomActionRef Id="FailUpgradeForTest" />
    <?endif ?>
  </Package>
</Wix>
