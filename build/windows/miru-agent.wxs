<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?define ProductName = "Miru Agent" ?>
  <?define Manufacturer = "Miru" ?>
  <?ifndef ProductCode ?><?define ProductCode = "*" ?><?endif ?>
  <!-- miru-agent service settings, shared by ServiceInstall, both ServiceConfig
       elements, and the rollback sc.exe commands below. util:ServiceConfig
       takes seconds and days, sc.exe failure takes milliseconds and seconds,
       and the preprocessor cannot convert, so each value is defined in both
       units side by side; change both of a pair together. The MSI tests
       (build/windows/tests/MsiTest.psm1) pin every value. -->
  <?define ServiceName = "miru-agent" ?>
  <?define ServiceFailureAction = "restart" ?>
  <?define ServiceRestartDelaySeconds = "10" ?>
  <?define ServiceRestartDelayMilliseconds = "10000" ?>
  <?define ServiceResetPeriodDays = "1" ?>
  <?define ServiceResetPeriodSeconds = "86400" ?>
  <?define ServiceSidType = "unrestricted" ?>
  <?define ServiceRequiredPrivilege = "SeChangeNotifyPrivilege" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           ProductCode="$(ProductCode)"
           UpgradeCode="B5ED0336-5F14-4308-A667-3CE8CDEF7D48"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">
    <!-- Never change UpgradeCode after publication: it is the permanent identity
         that relates every Miru Agent major-upgrade package. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Miru">
        <Directory Id="AGENTFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="MIRUDATA" Name="Miru">
        <Directory Id="MIRULOGS" Name="logs" />
        <Directory Id="MIRUAUTH" Name="auth" />
        <Directory Id="MIRUTMP" Name="tmp" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentBinary" Directory="AGENTFOLDER">
      <Component Id="MiruAgentExe" Guid="*" Bitness="always64">
        <File Id="miru_agent.exe"
              Name="miru-agent.exe"
              Source="$(BinDir)\miru-agent.exe"
              KeyPath="yes" />
        <!-- The SCM launches the bare exe (no subcommand, no console flag) as
             the service; Name must equal SERVICE_NAME in
             agent/src/windows/scm.rs. -->
        <ServiceInstall Id="MiruAgentService"
                        Name="$(ServiceName)"
                        DisplayName="Miru Agent"
                        Description="Miru Config Agent"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\$(ServiceName)"
                        Vital="yes"
                        Interactive="no">
          <!-- SCM restarts the service on failure; the Util extension is the
               reliable path to failure actions. -->
          <util:ServiceConfig FirstFailureActionType="$(ServiceFailureAction)"
                              SecondFailureActionType="$(ServiceFailureAction)"
                              ThirdFailureActionType="$(ServiceFailureAction)"
                              RestartServiceDelayInSeconds="$(ServiceRestartDelaySeconds)"
                              ResetPeriodInDays="$(ServiceResetPeriodDays)" />
          <!-- Core ServiceConfig (MsiServiceConfig), applied on install and
               repair: add the service SID to the process token and remove every
               privilege except SeChangeNotifyPrivilege, so the service cannot
               impersonate. util:ServiceConfig supports neither setting; WIX1149
               is suppressed in miru-agent.wixproj for this element. -->
          <ServiceConfig ServiceSid="$(ServiceSidType)" OnInstall="yes" OnReinstall="yes">
            <RequiredPrivilege Name="$(ServiceRequiredPrivilege)" />
          </ServiceConfig>
        </ServiceInstall>
        <ServiceControl Id="MiruAgentServiceControl"
                        Name="$(ServiceName)"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- These directory-keyed components deliberately contain no RemoveFolder or
         registry resource. Windows Installer reapplies the protected descriptor
         during repair and upgrade, while populated customer state survives an
         ordinary uninstall.
         The last two ACEs are for the miru-agent service SID (NT SERVICE\miru-agent;
         equals `sc.exe showsid miru-agent`). On each directory it may list,
         traverse, and add children but not delete, re-permission, or take
         ownership of the directory itself; it gets full control of everything
         created inside. The SID is hardcoded because CreateFolders applies these
         descriptors before InstallServices creates the service. All four
         directories carry the ACEs because their DACLs are protected and
         provisioning renames keys from tmp to auth. Recompute the SID in every
         Sddl if ServiceName changes. -->
    <ComponentGroup Id="DataDirs">
      <Component Id="MiruDataDir" Directory="MIRUDATA" Guid="D0542DF7-5B61-4F09-938B-57F05C1B5458" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruLogsDir" Directory="MIRULOGS" Guid="C3AF8332-28E8-4707-8430-780C553D86EC" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruAuthDir" Directory="MIRUAUTH" Guid="A2AE361A-41E6-427A-AF4C-ACCEE7F451F9" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
      <Component Id="MiruTmpDir" Directory="MIRUTMP" Guid="D654A9BF-2860-44FA-8FFB-A8E36986197B" Bitness="always64" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;FRFWFX;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)(A;OICIIO;FA;;;S-1-5-80-1251439239-454917380-1008020685-2030257057-91624695)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- Failed-upgrade rollback. With Schedule="afterInstallInitialize", a
         failed major upgrade rolls back the old version's uninstall, and
         Windows Installer recreates its service from the ServiceInstall row
         alone: the failure actions (Util ExecServiceConfig) and the SID type
         and required privileges (MsiConfigureServices) are not reapplied, so
         the restored service would keep SeImpersonatePrivilege. These rollback
         actions reapply them with sc.exe. They belong to the version being
         removed: they run only in the uninstall that RemoveExistingProducts
         starts (UPGRADINGPRODUCTCODE set, REMOVE=ALL), so each version restores
         its own settings, and they protect only upgrades from versions that
         contain them. They are sequenced after RemoveExistingProducts (ICE63
         allows no action between it and InstallInitialize) and before
         StopServices, so rollback, which replays the uninstall script in
         reverse, reaches them after DeleteServices' rollback recreates the
         service and StopServices' rollback restarts it. The restart action is
         sequenced first so it runs last: privileges and SID type apply only to
         a newly started process, so it restarts the service, but only if it is
         running (net stop && net start). Each action ignores failure, because
         a failed setting must not abort the rest of the rollback. Each
         SetProperty passes its command as CustomActionData. -->
    <?define RollbackCondition = 'UPGRADINGPRODUCTCODE AND REMOVE~="ALL"' ?>
    <CustomAction Id="MiruRollbackServiceRestart" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="MiruRollbackServiceFailureActions" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="MiruRollbackServiceSidType" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="MiruRollbackServicePrivileges" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />

    <SetProperty Id="MiruRollbackServiceRestart" Before="MiruRollbackServiceRestart" Sequence="execute"
                 Condition="$(RollbackCondition)"
                 Value="&quot;[System64Folder]cmd.exe&quot; /d /s /c &quot;&quot;[System64Folder]net.exe&quot; stop $(ServiceName) &amp;&amp; &quot;[System64Folder]net.exe&quot; start $(ServiceName)&quot;" />
    <SetProperty Id="MiruRollbackServiceFailureActions" Before="MiruRollbackServiceFailureActions" Sequence="execute"
                 Condition="$(RollbackCondition)"
                 Value="&quot;[System64Folder]sc.exe&quot; failure $(ServiceName) reset= $(ServiceResetPeriodSeconds) actions= $(ServiceFailureAction)/$(ServiceRestartDelayMilliseconds)/$(ServiceFailureAction)/$(ServiceRestartDelayMilliseconds)/$(ServiceFailureAction)/$(ServiceRestartDelayMilliseconds)" />
    <SetProperty Id="MiruRollbackServiceSidType" Before="MiruRollbackServiceSidType" Sequence="execute"
                 Condition="$(RollbackCondition)"
                 Value="&quot;[System64Folder]sc.exe&quot; sidtype $(ServiceName) $(ServiceSidType)" />
    <SetProperty Id="MiruRollbackServicePrivileges" Before="MiruRollbackServicePrivileges" Sequence="execute"
                 Condition="$(RollbackCondition)"
                 Value="&quot;[System64Folder]sc.exe&quot; privs $(ServiceName) $(ServiceRequiredPrivilege)" />

    <InstallExecuteSequence>
      <Custom Action="MiruRollbackServicePrivileges" Before="StopServices" Condition="$(RollbackCondition)" />
      <Custom Action="MiruRollbackServiceSidType" Before="SetMiruRollbackServicePrivileges" Condition="$(RollbackCondition)" />
      <Custom Action="MiruRollbackServiceFailureActions" Before="SetMiruRollbackServiceSidType" Condition="$(RollbackCondition)" />
      <Custom Action="MiruRollbackServiceRestart" Before="SetMiruRollbackServiceFailureActions" Condition="$(RollbackCondition)" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="AgentBinary" />
      <ComponentGroupRef Id="DataDirs" />
      <?ifdef IntegrationFixture ?>
      <ComponentGroupRef Id="IntegrationFixturePayload" />
      <?endif ?>
    </Feature>

    <?ifdef IntegrationFixture ?>
    <CustomActionRef Id="FailUpgradeForTest" />
    <?endif ?>
  </Package>
</Wix>
