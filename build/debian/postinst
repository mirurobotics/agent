#!/bin/sh

socket_name="miru.socket"
service_name="miru.service"

create_miru_group() {
  if ! getent group miru > /dev/null 2>&1; then
    printf "\033[32m Creating the 'miru' group\033[0m\n"
    groupadd -r miru
  fi
}

create_miru_user() {
  if ! id -u miru > /dev/null 2>&1; then
    printf "\033[32m Creating the 'miru' user\033[0m\n"
    useradd -r -g miru -s /bin/false miru
  else
    printf "\033[32m The 'miru' user already exists\033[0m\n"
  fi
}

tmpfiles_conf=/usr/lib/tmpfiles.d/miru-agent.conf

# The tmpfiles.d entry owns the folder modes (also re-applied at every boot).
# Each folder is the access boundary for its contents, so nothing inside is
# touched. systemd-tmpfiles exits 0 when it cannot fix a path, so check every
# `d` entry afterwards and fail the configure rather than leave the data root
# readable by others.
apply_folder_modes() {
  systemd-tmpfiles --create miru-agent.conf || return 1
  while read -r type path mode user group _; do
    [ "$type" = d ] || continue
    if [ ! -d "$path" ] || [ -L "$path" ]; then return 1; fi
    [ "$(stat -c '%a %U %G' "$path")" = "${mode#0} $user $group" ] || return 1
  done < "$tmpfiles_conf"
}

post_install() {
    socket_name="$1"
    printf "\033[32m Post Install of an upgrade\033[0m\n"

    # create the miru user and group, then the miru directories
    create_miru_group
    create_miru_user
    printf "\033[32m Applying the miru directory modes\033[0m\n"
    if ! apply_folder_modes; then
      printf "\033[31m Failed to set ownership and modes of the miru directories\033[0m\n" >&2
      exit 1
    fi

    # reload the unit from disk 
    printf "\033[32m Reload the service unit from disk\033[0m\n"
    systemctl daemon-reload

    # enable the socket
    printf "\033[32m Enable the socket\033[0m\n"
    systemctl enable "${socket_name}"

    # socket restart
    printf "\033[32m Restart the socket\033[0m\n"
    systemctl restart "${socket_name}"

    # enable the service
    printf "\033[32m Enable the service\033[0m\n"
    systemctl enable "${service_name}"

    # service restart
    printf "\033[32m Restart the service\033[0m\n"
    systemctl restart "${service_name}"

}

# Step 2, check if this is a clean install or an upgrade
action="$1"
if [ "$1" = "configure" ] && [ -z "$2" ]; then
  action="install"
elif [ "$1" = "configure" ] && [ -n "$2" ]; then
  action="upgrade"
fi

case "$action" in
  "install")
    printf "\033[32m Post Install of an clean install\033[0m\n"
    post_install "${socket_name}"
    ;;
  "upgrade")
    printf "\033[32m Post Install of an upgrade\033[0m\n"
    post_install "${socket_name}"
    ;;
esac

exit 0