#!/bin/sh

socket_name="miru.socket"
service_name="miru.service"

create_miru_group() {
  if ! getent group miru > /dev/null 2>&1; then
    printf "\033[32m Creating the 'miru' group\033[0m\n"
    groupadd -r miru
  fi
}

create_miru_user() {
  if ! id -u miru > /dev/null 2>&1; then
    printf "\033[32m Creating the 'miru' user\033[0m\n"
    useradd -r -g miru -s /bin/false miru
  else
    printf "\033[32m The 'miru' user already exists\033[0m\n"
  fi
}

create_miru_users_group() {
  if getent group miru-users > /dev/null 2>&1; then return 0; fi
  printf "\033[32m Creating the 'miru-users' group\033[0m\n"
  groupadd -r miru-users
  migrate_miru_members
}

# One-time copy of accounts that used the miru group for socket access:
# supplementary members plus accounts whose primary group is miru.
migrate_miru_members() {
  miru_gid=$(getent group miru | cut -d: -f3)
  members=$(getent group miru | cut -d: -f4 | tr ',' ' ')
  primaries=$(getent passwd | awk -F: -v gid="$miru_gid" '$4 == gid { print $1 }')
  for member in $members $primaries; do
    [ "$member" = "miru" ] && continue
    printf "\033[32m Adding '%s' to 'miru-users' (re-login or restart its services to apply)\033[0m\n" "$member"
    usermod -a -G miru-users "$member"
  done
}

# Runs on every configure. The old postrm stops the service before this
# runs, so it cannot race these recursive changes; chown -R also never
# follows symlinks met during traversal.
apply_permissions() {
  mkdir -p /var/lib/miru /var/log/miru /srv/miru/configs
  chown -R miru:miru /var/lib/miru
  chmod -R u=rwX,go= /var/lib/miru
  pub=/var/lib/miru/auth/public_key.pem
  if [ -f "$pub" ] && [ ! -L "$pub" ]; then chmod 0640 "$pub"; fi

  chown -R miru:miru /var/log/miru
  chmod -R o-rwx /var/log/miru
  chmod 0750 /var/log/miru

  chown miru:miru /srv/miru
  chmod 0755 /srv/miru
  chown -R miru:miru-users /srv/miru/configs
  chmod -R g+rX,g-w,o-rwx /srv/miru/configs
  find /srv/miru/configs -type d -exec chmod g+s {} +
}

post_install() {
    socket_name="$1"
    printf "\033[32m Post Install of an upgrade\033[0m\n"

    # create the miru user and groups, then apply ownership and modes
    create_miru_group
    create_miru_user
    create_miru_users_group
    apply_permissions

    # create /run/miru now; tmpfiles.d recreates it at every boot
    printf "\033[32m Creating the /run/miru directory\033[0m\n"
    systemd-tmpfiles --create miru-agent.conf

    # reload the unit from disk 
    printf "\033[32m Reload the service unit from disk\033[0m\n"
    systemctl daemon-reload

    # enable the socket
    printf "\033[32m Enable the socket\033[0m\n"
    systemctl enable "${socket_name}"

    # socket restart
    printf "\033[32m Restart the socket\033[0m\n"
    systemctl restart "${socket_name}"

    # enable the service
    printf "\033[32m Enable the service\033[0m\n"
    systemctl enable "${service_name}"

    # service restart
    printf "\033[32m Restart the service\033[0m\n"
    systemctl restart "${service_name}"

}

# Step 2, check if this is a clean install or an upgrade
action="$1"
if [ "$1" = "configure" ] && [ -z "$2" ]; then
  action="install"
elif [ "$1" = "configure" ] && [ -n "$2" ]; then
  action="upgrade"
fi

case "$action" in
  "install")
    printf "\033[32m Post Install of an clean install\033[0m\n"
    post_install "${socket_name}"
    ;;
  "upgrade")
    printf "\033[32m Post Install of an upgrade\033[0m\n"
    post_install "${socket_name}"
    ;;
esac

exit 0