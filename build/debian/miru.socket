[Unit]
Description=Miru Config Agent socket

[Socket]
# /run/miru comes from tmpfiles.d (miru:miru 0750), so it exists before the
# socket binds and outlives socket and service restarts.
ListenStream=/run/miru/miru.sock
SocketMode=0660
SocketGroup=miru
RemoveOnStop=yes

[Install]
WantedBy=sockets.target