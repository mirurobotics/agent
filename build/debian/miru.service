[Unit]
Description=Miru Config Agent
After=network.target
Requires=miru.socket

[Service]
Type=simple

# user and group
Group=miru
User=miru

# runtime
StateDirectory=miru
StateDirectoryMode=0700
LogsDirectory=miru
LogsDirectoryMode=0750
ExecStart=/usr/sbin/miru-agent
WorkingDirectory=/var/lib/miru

# logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miru-agent

# security
# ReadWritePaths is kept even though ProtectSystem is not enabled by
# default. It is a no-op in the default configuration, but becomes
# meaningful if a customer ships a hardening drop-in that enables
# ProtectSystem=strict — the agent's own working directories are then
# writable without the customer needing to remember to add them.
ReadWritePaths=/var/lib/miru /var/log/miru /srv/miru /run/miru
# Prevents the service and its children from gaining new privileges
NoNewPrivileges=true
# Gives the service a private /tmp and /var/tmp
PrivateTmp=true
# Restricts access to /dev, only allowing minimal device nodes
PrivateDevices=true
# Restricts the service’s view of /proc to only its own processes (Linux 5.8+)
ProtectProc=invisible
# Makes kernel tunable files (e.g., /proc/sys, /sys) read-only or inaccessible
ProtectKernelTunables=true
# Prevents loading or unloading of kernel modules
ProtectKernelModules=true
# Prevents modification of cgroup settings
ProtectControlGroups=true
# Limits network protocols to UNIX sockets, IPv4, and IPv6
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Prevents gaining real-time scheduling privileges
RestrictRealtime=true
# Prevents creating or executing set-user-ID or set-group-ID files
RestrictSUIDSGID=true
# Drops every capability from the bounding and ambient sets
CapabilityBoundingSet=
AmbientCapabilities=
# Locks the execution domain (personality) so it cannot be changed
LockPersonality=true
# Prevents creating new namespaces
RestrictNamespaces=true
# Only allows system calls of the native architecture
SystemCallArchitectures=native
# Prevents changing the system clock
ProtectClock=true
# Prevents reading or writing the kernel log ring buffer
ProtectKernelLogs=true
# Deliberately not enabled:
# - ProtectSystem=strict / ProtectHome: configs deploy to, and uploads read,
#   arbitrary customer paths
# - ProtectHostname: its private UTS namespace freezes the reported hostname
# - a stricter UMask: consumers of deployed configs rely on 0644 files


[Install]
WantedBy=multi-user.target
